{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebMix Pro",
  "version": "1.1.0",
  "identifier": "io.github.jugkritsopng.webmix",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": { "script": "node scripts/prepare-web.mjs", "cwd": ".." },
    "beforeDevCommand": { "script": "node scripts/prepare-web.mjs", "cwd": ".." }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Live production switcher",
    "longDescription": "WebMix Pro: switch cameras, overlays and graphics, record, and stream to many destinations at once (RTMP/SRT) with the built-in Stream Gateway.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "entitlements": "entitlements.plist", "minimumSystemVersion": "11.0" },
    "linux": {
      "deb": { "depends": ["ffmpeg", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"] },
      "rpm": { "depends": ["ffmpeg", "gstreamer1-plugins-good", "gstreamer1-plugins-bad-free"] }
    },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "android": { "minSdkVersion": 24 }
  }
}
